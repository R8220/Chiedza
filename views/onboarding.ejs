<section class="onboarding-shell" data-onboarding><div class="onboarding-lantern" aria-hidden="true"><div class="mini-flame"></div></div><form method="post" action="/onboarding" class="onboarding-card">
<div class="onboarding-step active" data-step="0"><p class="eyebrow">00:00 · Arrival</p><h1><%= copy.arrival %></h1><p class="quiet-copy">Nothing is scored here. You can move slowly.</p><button type="button" class="button" data-next>Continue when ready</button></div>
<div class="onboarding-step" data-step="1"><p class="eyebrow">00:15 · Consent</p><h2><%= copy.consent %></h2><p class="quiet-copy">AI is disclosed. You control therapist visibility, transcript sharing and recording permissions.</p><div class="consent-grid"><label class="toggle-row"><span>Therapist can see care summaries</span><input type="checkbox" name="therapistVisibility" checked></label><label class="toggle-row"><span>Share raw transcript when I choose</span><input type="checkbox" name="transcriptSharing"></label><label class="toggle-row"><span>Allow session recording</span><input type="checkbox" name="recordingConsent"></label></div><button type="button" class="button" data-next>Continue</button></div>
<div class="onboarding-step" data-step="2"><p class="eyebrow">00:30 · Capacity</p><h2><%= copy.capacity %></h2><div class="choice-grid"><label><input type="radio" name="capacity" value="little"><span>A little</span></label><label><input type="radio" name="capacity" value="some" checked><span>Some</span></label><label><input type="radio" name="capacity" value="not_much"><span>Not much</span></label><label><input type="radio" name="capacity" value="unknown"><span>I don't know</span></label></div><button type="button" class="button" data-next>Continue</button></div>
<div class="onboarding-step" data-step="3"><p class="eyebrow">00:45 · Cultural relevance</p><h2>Let the system meet your context.</h2><div class="field-grid"><label>Language<select name="language"><% supportedLanguages.forEach(l => { %><option value="<%= l.code %>"><%= l.label %></option><% }) %></select></label><label>Cultural / regional context<input name="culture" placeholder="e.g. Zimbabwean, Nigerian, South African, UK diaspora"></label><label>Optional faith alignment<input name="faith" placeholder="e.g. Christian, Muslim, Traditional, none"></label><label>Communication preference<select name="communicationPreference"><option value="chat">Chat only</option><option value="voice_chat">Voice + chat</option><option value="scheduled">Scheduled sessions only</option></select></label></div><button type="button" class="button" data-next>Continue</button></div>
<div class="onboarding-step" data-step="4"><p class="eyebrow">01:00 · Routing question</p><h2><%= copy.routing %></h2><div class="choice-grid"><% ['anxiety','burnout','grief','trauma','sleep','loneliness'].forEach(n => { %><label><input type="checkbox" name="needs" value="<%= n %>"><span><%= n[0].toUpperCase() + n.slice(1) %></span></label><% }) %></div><label>Therapist gender preference (optional)<select name="preferredTherapistGender"><option value="">No preference</option><option value="female">Female</option><option value="male">Male</option><option value="nonbinary">Non-binary</option></select></label><button type="button" class="button" data-next>See how rooms end</button></div>
<div class="onboarding-step" data-step="5"><p class="eyebrow">01:15 · A taste of aftercare</p><h2>Whatever happens in this room, this is how it ends.</h2><p class="aftercare-preview">The pace slows. You notice what changed. You choose what happens next. You are not pushed into another activity.</p><button class="button" type="submit">Enter Chiedza</button></div>
</form></section>
