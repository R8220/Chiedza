<% if(games && games.length){ %><section class="room-games-section"><div class="room-games-inner"><span class="eyebrow">Gentle games in this room</span><h2>Play without pressure</h2><p>Choose a small activity. There are no leaderboards, streaks or fail states.</p><div class="game-card-grid"><% games.forEach(game=>{ %><a class="game-card" href="/games/<%= game.id %>"><span class="game-type"><%= game.gameType==='memory'?'Memory Match':game.gameType==='wordsearch'?'Word Search':game.gameType==='pattern'?'Pattern Match':'Breathing Tap' %></span><h3><%= game.title %></h3><p><%= game.description %></p><small><%= game.difficulty %> · play gently →</small></a><% }) %></div></div></section><% } %>
