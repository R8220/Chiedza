<section class="page-shell game-page" data-game-type="<%= game.gameType %>"><div class="game-shell card"><a class="back-link" href="/rooms/<%= game.room %>">← Back to room</a><div class="page-header centered"><span class="eyebrow"><%= game.room %> room · <%= game.difficulty %></span><h1><%= game.title %></h1><p><%= game.description %></p></div><div id="game-root" class="gentle-game" data-game-type="<%= game.gameType %>" aria-live="polite"></div><div class="game-footer"><p>No scores, streaks or public ranking. Stop whenever you want.</p><button id="game-restart" class="button button-ghost" type="button">Start again</button></div></div></section><script src="/js/games.js" defer></script>
