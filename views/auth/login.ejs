<section class="auth-shell"><div class="auth-copy"><p class="eyebrow">Gentle return</p><h1>Welcome back.</h1><p>We kept your place.</p></div><form class="form-card" method="post" action="/login"><h2>Sign in</h2><% if (errors?.length) { %><div class="form-errors"><% errors.forEach(e => { %><p><%= e.msg %></p><% }) %></div><% } %><label>Email<input type="email" name="email" required autocomplete="email"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button class="button button-block" type="submit">Enter quietly</button><p class="form-foot">New here? <a href="/register">Create your place</a></p></form></section>
