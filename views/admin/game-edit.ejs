<section class="page-shell admin-shell"><div class="page-header"><span class="eyebrow">Games</span><h1>Edit game</h1><p>Update how this activity appears in the Quiet Arcade.</p></div><div class="card form-card narrow-card"><form method="post" action="/admin/games/<%= game.id %>/edit" class="stack-form"><label>Game title<input name="title" required maxlength="160" value="<%= game.title %>"></label><label>Description<textarea name="description" rows="4" maxlength="1200"><%= game.description %></textarea></label><div class="form-grid two"><label>Room<select name="room"><% [['calm','Calm Me'],['ground','Ground Me'],['rest','Let Me Rest'],['return','Help Me Return']].forEach(([v,l])=>{ %><option value="<%= v %>" <%= game.room===v?'selected':'' %>><%= l %></option><% }) %></select></label><label>Game type<select name="gameType"><% [['memory','Memory Match'],['wordsearch','Word Search'],['pattern','Pattern Match'],['breathing','Breathing Tap']].forEach(([v,l])=>{ %><option value="<%= v %>" <%= game.gameType===v?'selected':'' %>><%= l %></option><% }) %></select></label></div><div class="form-grid two"><label>Difficulty<select name="difficulty"><% ['gentle','easy','medium'].forEach(v=>{ %><option value="<%= v %>" <%= game.difficulty===v?'selected':'' %>><%= v[0].toUpperCase()+v.slice(1) %></option><% }) %></select></label><label>Display order<input type="number" name="displayOrder" value="<%= game.displayOrder %>" min="0" max="9999"></label></div><label class="form-check"><input type="checkbox" name="active" <%= game.active?'checked':'' %>> <span>Active and visible to users</span></label><div class="inline-actions"><button class="button" type="submit">Save changes</button><a class="button button-ghost" href="/admin/games">Cancel</a></div></form></div></section>
