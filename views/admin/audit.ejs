<section class="page-shell admin-shell"><div class="page-header"><span class="eyebrow">Governance</span><h1>Audit trail</h1><p>Human review actions and sensitive care corrections are recorded for operational accountability.</p></div><div class="table-wrap card"><table><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th><th>Details</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><small><%= new Date(l.createdAt).toLocaleString() %></small></td><td><%= l.actor?.name || 'System' %><small><%= l.actor?.role || '' %></small></td><td><code><%= l.action %></code></td><td><%= l.targetType %> #<%= l.targetId || '—' %></td><td><small><%= JSON.stringify(l.details||{}) %></small></td></tr><% }) %></tbody></table></div></section>
