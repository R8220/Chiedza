<section class="page-shell admin-shell"><div class="page-header"><span class="eyebrow">Content management</span><h1>Games</h1><p>Add gentle activities to the Quiet Arcade and choose which room each game belongs to.</p></div>
<div class="two-col admin-content-grid"><section class="card form-card"><span class="eyebrow">New game</span><h2>Add a game</h2><form method="post" action="/admin/games" class="stack-form"><label>Game title<input name="title" required maxlength="160" placeholder="e.g. Calm Memory Match"></label><label>Description<textarea name="description" rows="4" maxlength="1200" placeholder="A short description for the user."></textarea></label><div class="form-grid two"><label>Room<select name="room"><option value="calm">Calm Me</option><option value="ground">Ground Me</option><option value="rest">Let Me Rest</option><option value="return">Help Me Return</option></select></label><label>Game type<select name="gameType"><option value="memory">Memory Match</option><option value="wordsearch">Word Search</option><option value="pattern">Pattern Match</option><option value="breathing">Breathing Tap</option></select></label></div><div class="form-grid two"><label>Difficulty<select name="difficulty"><option value="gentle">Gentle</option><option value="easy">Easy</option><option value="medium">Medium</option></select></label><label>Display order<input type="number" name="displayOrder" value="100" min="0" max="9999"></label></div><label class="form-check"><input type="checkbox" name="active" checked> <span>Active and visible to users</span></label><button class="button" type="submit">Add game</button></form></section>
<section><% if(!games.length){ %><div class="card"><h2>No games yet</h2><p>Add the first Quiet Arcade game using the form.</p></div><% } %><% games.forEach(game=>{ %><article class="card game-admin-card"><div class="section-heading"><div><span class="tag"><%= game.room %></span><span class="tag"><%= game.gameType %></span><span class="tag"><%= game.difficulty %></span><span class="tag"><%= game.active?'Active':'Inactive' %></span></div><small>Order <%= game.displayOrder %></small></div><h2><%= game.title %></h2><p><%= game.description || 'No description.' %></p><div class="inline-actions"><a class="button button-sm" href="/admin/games/<%= game.id %>/edit">Edit</a><form method="post" action="/admin/games/<%= game.id %>/status"><input type="hidden" name="active" value="<%= game.active?'false':'true' %>"><button class="button button-sm button-ghost" type="submit"><%= game.active?'Deactivate':'Activate' %></button></form><form method="post" action="/admin/games/<%= game.id %>/delete" onsubmit="return confirm('Delete this game?')"><button class="button button-sm danger-button" type="submit">Delete</button></form></div></article><% }) %></section></div></section>
