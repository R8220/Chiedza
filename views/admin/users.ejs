<section class="page-shell admin-shell"><div class="page-header"><span class="eyebrow">People & Matching</span><h1>Users, roles and therapist capacity</h1></div>
  <details class="card create-panel"><summary>Create account</summary><form method="post" action="/admin/users" class="form-grid three"><label>Name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Password<input name="password" value="ChangeMe123!" required></label><label>Role<select name="role"><option>user</option><option>therapist</option><option>reviewer</option><option>caregiver</option><option>admin</option></select></label><label>Therapist specialties<input name="specialties" placeholder="anxiety, grief"></label><label>Languages<input name="languages" value="en"></label><label>Workload limit<input type="number" name="workloadLimit" value="20"></label><label class="check-line"><input type="checkbox" name="crisisCapability"><span>Crisis capable</span></label><div><button class="button">Create</button></div></form></details>
  <div class="table-wrap card"><table><thead><tr><th>Person</th><th>Role</th><th>Status</th><th>Profile</th><th>Controls</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.name %></strong><small><%= u.email %></small></td><td><span class="status"><%= u.role %></span></td><td><%= u.isActive?'Active':'Inactive' %></td><td><% if(u.therapistProfile){ %><small><%= (u.therapistProfile.specialties||[]).join(', ') %><br>limit <%= u.therapistProfile.workloadLimit %></small><% } else { %>—<% } %></td><td><div class="button-row"><% if(u.role==='user'){ %><form method="post" action="/admin/users/<%= u.id %>/assign"><button class="button button-sm">Auto-match therapist</button></form><% } %><% if(u.id!==currentUser.id){ %><form method="post" action="/admin/users/<%= u.id %>/status"><input type="hidden" name="active" value="<%= u.isActive?'false':'true' %>"><button class="button button-ghost button-sm"><%= u.isActive?'Deactivate':'Activate' %></button></form><% } %></div></td></tr><% }) %></tbody></table></div>
</section>
