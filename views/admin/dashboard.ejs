<section class="page-shell admin-shell"><div class="page-header"><span class="eyebrow">Operations & Safety</span><h1>Chiedza Operations</h1><p>System health, recovery metrics and operational capacity without engagement-first metrics.</p></div>
  <div class="metric-grid"><% [['Users',metrics.users],['Therapists',metrics.therapists],['Open safety flags',metrics.openFlags],['Pending lanterns',metrics.pendingLanterns],['Room sessions',metrics.roomSessions],['Check-ins',metrics.checkIns],['Aftercare completion',metrics.aftercareRate===null?'—':metrics.aftercareRate+'%']].forEach(([label,value])=>{ %><article class="metric-card"><strong><%= value %></strong><span><%= label %></span></article><% }) %></div>
  <div class="dashboard-grid"><section class="card span-2"><div class="section-heading"><div><span class="eyebrow">Recent people</span><h2>New accounts</h2></div><a href="/admin/users" class="text-link">Manage →</a></div><div class="data-list"><% latestUsers.forEach(u=>{ %><div class="data-row"><div><strong><%= u.name %></strong><small><%= u.email %></small></div><span class="status"><%= u.role %></span><small><%= new Date(u.createdAt).toLocaleDateString() %></small></div><% }) %></div></section><aside class="card"><span class="eyebrow">Operational setup</span><h2>Production checklist</h2><ul class="clean-list"><li><a href="/admin/quotes">Manage dashboard quotes</a></li><li><a href="/admin/crisis-contacts">Verify regional crisis directory</a></li><li><a href="/reviewer">Staff human review queue</a></li><li><a href="/admin/users">Review therapist capacity</a></li><li><a href="/admin/audit">Inspect audit trail</a></li></ul></aside></div>
</section>
