<section class="page-shell clinical-shell"><div class="page-header split-header"><div><a class="text-link" href="/therapist">← Caseload</a><span class="eyebrow">Clinical workspace</span><h1><%= client.name %></h1><p><%= client.email %> · mode <strong><%= client.therapeuticMode %></strong> · capacity <strong><%= client.capacity %></strong></p></div><a class="button" href="/therapist/messages/<%= client.id %>">Secure chat</a></div>
  <div class="dashboard-grid">
    <section class="card span-2"><span class="eyebrow">AI Insight Review</span><h2>Structured care summaries</h2><% if(!summaries.length){ %><p class="muted">No summary generated yet.</p><% } %><div class="timeline"><% summaries.forEach(s=>{ %><article><time><%= new Date(s.createdAt).toLocaleString() %></time><pre><%= s.summary %></pre><form method="post" action="/therapist/summaries/<%= s.id %>/review" class="form-stack"><label>Clinician correction / context<textarea name="clinicianCorrection" rows="3"><%= s.clinicianCorrection %></textarea></label><button class="button button-sm">Mark reviewed</button></form></article><% }) %></div></section>
    <aside class="card"><span class="eyebrow">Risk history</span><h2>Safeguarding signals</h2><div class="mini-list"><% flags.forEach(f=>{ %><div><span class="risk-dot risk-<%= f.riskLevel %>"></span><strong><%= f.source %></strong><small><%= f.riskLevel %> · <%= f.status %></small><p><%= f.excerpt %></p></div><% }) %></div></aside>
    <section class="card span-3"><span class="eyebrow">Progress trends</span><h2>Recent check-ins</h2><div class="checkin-strip"><% checkIns.forEach(c=>{ %><div title="<%= c.note %>"><span class="mood-ball mood-<%= c.mood %>"><%= c.mood %></span><small><%= new Date(c.createdAt).toLocaleDateString() %></small><em><%= c.state %></em></div><% }) %></div></section>
    <section class="card span-2"><span class="eyebrow">Clinical tools</span><h2>New SOAP note</h2><form method="post" action="/therapist/users/<%= client.id %>/soap" class="form-grid two"><label>Subjective<textarea name="subjective" rows="4"></textarea></label><label>Objective<textarea name="objective" rows="4"></textarea></label><label>Assessment<textarea name="assessment" rows="4"></textarea></label><label>Plan<textarea name="plan" rows="4"></textarea></label><div class="span-2"><button class="button">Save encrypted note</button></div></form></section>
    <section class="card"><span class="eyebrow">Care planning</span><h2>Adjust care plan</h2><form method="post" action="/therapist/users/<%= client.id %>/care-plan" class="form-stack"><label>Goals<textarea name="goals" rows="3" placeholder="One per line"></textarea></label><label>Warning signs<textarea name="warningSigns" rows="3"></textarea></label><label>Preferences<textarea name="preferences" rows="3"></textarea></label><label>Next actions<textarea name="nextActions" rows="3"></textarea></label><button class="button button-sm">Save plan</button></form></section>
    <% if(client.transcriptSharing){ %><section class="card span-2"><span class="eyebrow">Consent-granted journal view</span><h2>Recent reflections</h2><% journals.forEach(j=>{ %><article class="journal-clinical"><small><%= j.type %> · <%= new Date(j.createdAt).toLocaleString() %></small><p><%= j.content %></p></article><% }) %></section><% } else { %><section class="card span-2 empty-state"><h2>Raw journal content is hidden.</h2><p>The user has not granted transcript/journal sharing.</p></section><% } %>
    <aside class="card"><span class="eyebrow">Room activity</span><h2>Quiet Arcade</h2><div class="mini-list"><% roomSessions.slice(0,10).forEach(r=>{ %><div><strong><%= r.room %></strong><small><%= new Date(r.createdAt).toLocaleDateString() %> · aftercare <%= r.aftercareCompleted?'complete':'not complete' %></small></div><% }) %></div></aside>
  </div>
</section>
