<section class="page-shell clinical-shell"><div class="page-header split-header"><div><span class="eyebrow">Human Support Module</span><h1>Therapist Corner</h1><p>Structured summaries first. Raw emotional data only when user consent permits it.</p></div><div class="metric-pill"><strong><%= assignments.length %></strong><span>active clients</span></div></div>
  <% if(riskFlags.length){ %><section class="alert-band"><strong><%= riskFlags.length %> active safeguarding flag<%= riskFlags.length===1?'':'s' %></strong><span>Human review remains authoritative.</span></section><% } %>
  <div class="dashboard-grid"><section class="card span-2"><div class="section-heading"><div><span class="eyebrow">Assigned users</span><h2>Caseload</h2></div></div><div class="data-list"><% assignments.forEach(a=>{ %><a class="data-row" href="/therapist/users/<%= a.client.id %>"><div><strong><%= a.client.name %></strong><small><%= a.client.email %></small></div><div><span class="status"><%= a.client.therapeuticMode %></span><small>capacity: <%= a.client.capacity %></small></div><span>→</span></a><% }) %><% if(!assignments.length){ %><p class="muted">No active assignments.</p><% } %></div></section>
  <aside class="card"><span class="eyebrow">Safeguarding</span><h2>Risk indicators</h2><div class="mini-list"><% riskFlags.slice(0,8).forEach(f=>{ %><div><span class="risk-dot risk-<%= f.riskLevel %>"></span><strong><%= f.User?.name || 'User' %></strong><small><%= f.riskLevel %> · <%= f.status %></small></div><% }) %></div></aside>
  <section class="card span-3"><span class="eyebrow">Scheduled care</span><h2>Session requests</h2><div class="table-wrap"><table><thead><tr><th>User</th><th>When</th><th>Format</th><th>Status</th><th>Action</th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><%= b.client?.name %></td><td><%= new Date(b.scheduledAt).toLocaleString() %></td><td><%= b.type %></td><td><span class="status"><%= b.status %></span></td><td><form method="post" action="/therapist/bookings/<%= b.id %>/status" class="inline-form"><select name="status"><option>confirmed</option><option>completed</option><option>cancelled</option></select><button class="button button-sm">Update</button></form></td></tr><% }) %></tbody></table></div></section></div>
</section>
