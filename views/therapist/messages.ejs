<section class="page-shell narrow-shell clinical-shell"><div class="page-header"><a href="/therapist/users/<%= client.id %>" class="text-link">← <%= client.name %></a><span class="eyebrow">Secure care chat</span><h1>Messages</h1></div><div class="message-panel card"><div class="message-stream"><% messages.forEach(m=>{ %><div class="bubble <%= m.senderId===currentUser.id?'mine':'theirs' %>"><p><%= m.content %></p><time><%= new Date(m.createdAt).toLocaleString() %></time></div><% }) %></div><form method="post" action="/therapist/messages/<%= client.id %>" class="message-form"><textarea name="message" rows="2" required placeholder="Write a secure message…"></textarea><button class="button">Send</button></form></div></section>
