<!doctype html>
<html lang="en" class="<%= currentUser?.reducedMotion ? 'reduced-motion' : '' %> <%= currentUser?.lowBatteryMode ? 'low-battery' : '' %>">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#2B2118">
  <title><%= title ? `${title} · Chiedza` : 'Chiedza' %></title>
  <meta name="description" content="Chiedza - continuous emotional care intelligence for the recovery gap.">
  <link rel="manifest" href="/manifest.webmanifest"><link rel="icon" href="/img/lantern.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Lora:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="<%= currentUser ? '/app' : '/' %>" aria-label="Chiedza home"><span class="brand-mark" aria-hidden="true">✦</span><span class="brand-name">Chiedza</span><span class="brand-sub">a light for the after</span></a>
  <nav class="nav-links" aria-label="Main navigation">
    <% if (!currentUser) { %><a href="/about">About</a><a href="/pricing">Access</a><a href="/login">Sign in</a><a class="button button-sm" href="/register">Begin gently</a>
    <% } else if (currentUser.role === 'user') { %><a href="/app">Home</a><a href="/listener">AI Listener</a><a href="/rooms">Quiet Arcade</a><a href="/mindfulness">Mindfulness</a><a href="/app/recovery">Recovery</a><details class="nav-more"><summary>More</summary><div><a href="/community">Carry With Me</a><a href="/app/sessions">Sessions</a><a href="/app/messages">Messages</a><a href="/app/settings">Consent & Settings</a></div></details>
    <% } else if (currentUser.role === 'therapist') { %><a href="/therapist">Therapist Corner</a>
    <% } else if (currentUser.role === 'reviewer') { %><a href="/reviewer">Care Review Queue</a>
    <% } else if (currentUser.role === 'admin') { %><a href="/admin">Operations</a><a href="/admin/users">People</a><a href="/admin/quotes">Quotes</a><a href="/admin/games">Games</a><a href="/admin/crisis-contacts">Crisis Directory</a><a href="/admin/audit">Audit</a><a href="/reviewer">Review Queue</a><% } %>
    <% if (currentUser) { %><form method="post" action="/logout" class="inline-form"><button class="link-button" type="submit">Sign out</button></form><% } %>
  </nav>
</header>
  <main class="site-main">
    <% if (notice) { %><div class="notice notice-<%= notice.type || 'info' %>" role="status"><%= notice.text %></div><% } %>
    <%- body %>
  </main>
  <footer class="site-footer"><div><strong>Chiedza</strong><span>A listener, reflector and care-routing system - not a replacement for a therapist or emergency service.</span></div><div class="footer-links"><a href="/about">Ethical perimeter</a><a href="/pricing">Access</a><a href="/offline.html">Offline grounding</a></div></footer>
  <script src="/js/app.js" defer></script>
</body>
</html>
