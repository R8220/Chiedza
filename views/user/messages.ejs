<section class="page-shell narrow-shell"><div class="page-header"><span class="eyebrow">Direct care delivery</span><h1>Secure messages</h1><p>Text is encrypted at rest in this prototype. Production deployment should use a reviewed end-to-end communications architecture.</p></div>
  <% if(!assignment){ %><div class="card empty-state"><h2>No therapist assigned yet.</h2><p>Secure chat will appear after care matching.</p></div><% } else { %>
  <div class="message-panel card"><div class="message-head"><div><small>Primary therapist</small><strong><%= assignment.therapist.name %></strong></div><span class="status good">Connected</span></div><div class="message-stream"><% if(!messages.length){ %><p class="muted center">No messages yet.</p><% } %><% messages.forEach(m=>{ %><div class="bubble <%= m.senderId===currentUser.id?'mine':'theirs' %>"><p><%= m.content %></p><time><%= new Date(m.createdAt).toLocaleString() %></time></div><% }) %></div><form method="post" action="/app/messages" class="message-form"><textarea name="message" rows="2" required placeholder="Write a secure message…"></textarea><button class="button" type="submit">Send</button></form></div><% } %>
</section>
