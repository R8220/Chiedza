<section class="page-shell narrow-shell"><div class="page-header"><span class="eyebrow">Human support</span><h1>Sessions</h1><p>Request chat, audio or video care with your assigned therapist. This prototype stores the schedule and workflow; production media providers are configured separately.</p></div>
  <form method="post" action="/app/sessions" class="card form-grid two"><label>Format<select name="type"><option value="chat">Chat</option><option value="audio">Audio</option><option value="video">Video</option></select></label><label>Preferred date & time<input type="datetime-local" name="scheduledAt" required></label><label class="span-2">Anything your therapist should know?<textarea name="notes" rows="3"></textarea></label><div class="span-2"><button class="button" type="submit" <%= assignment?'':'disabled' %>>Request session</button><% if(!assignment){ %><p class="hint">A primary therapist must be assigned first.</p><% } %></div></form>
  <div class="list-stack"><% bookings.forEach(b=>{ %><article class="card list-row"><div><span class="tag"><%= b.type %></span><h2><%= b.therapist?.name || 'Therapist' %></h2><p><%= new Date(b.scheduledAt).toLocaleString() %></p></div><span class="status <%= b.status==='confirmed'?'good':'' %>"><%= b.status %></span></article><% }) %></div>
</section>
