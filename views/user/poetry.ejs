<section class="page-shell narrow-shell"><div class="page-header"><span class="eyebrow">AI-Powered Grief & Healing Poetry Generator™</span><h1>Turn a feeling into language.</h1><p>This creative tool reflects what you provide. It is not therapy, diagnosis, or a promise of healing.</p></div>
  <div class="card poetry-studio"><form id="poetry-form" class="form-stack"><label>What are you carrying?<textarea id="poetry-prompt" rows="6" required placeholder="A feeling, memory, image or sentence…"></textarea></label><label>Form<select id="poetry-format"><option>free verse</option><option>haiku</option><option>prose poetry</option><option>sonnet-inspired</option></select></label><button class="button" type="submit">Create a reflection poem</button></form><article id="poetry-output" class="poem-output" hidden></article></div>
</section>
<script>
document.getElementById('poetry-form').addEventListener('submit',async(e)=>{e.preventDefault();const out=document.getElementById('poetry-output');out.hidden=false;out.textContent='A small light is forming…';try{const r=await fetch('/api/ai/poem',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:document.getElementById('poetry-prompt').value,format:document.getElementById('poetry-format').value})});const d=await r.json();out.textContent=d.poem||d.error||'The poem could not be created.';}catch{out.textContent='The poem could not be created right now.';}});
</script>
