<section class="page-shell narrow-shell"><div class="page-header"><span class="eyebrow">Companion Mode™</span><h1>Care can include people you trust.</h1><p>You control exactly which parts of your care summary a caregiver or loved one may see.</p></div>
  <form method="post" action="/app/companion" class="card form-stack"><h2>Invite an existing caregiver account</h2><label>Caregiver email<input type="email" name="email" required></label><fieldset><legend>Permission scopes</legend><div class="check-grid"><label><input type="checkbox" name="scopes" value="summary" checked><span>Care summary</span></label><label><input type="checkbox" name="scopes" value="milestones" checked><span>Milestones</span></label><label><input type="checkbox" name="scopes" value="care_plan"><span>Care plan</span></label></div></fieldset><button class="button" type="submit">Update companion access</button></form>
  <div class="list-stack"><% links.forEach(link=>{ %><article class="card list-row"><div><h2><%= link.caregiver?.name %></h2><p><%= link.caregiver?.email %> · <%= link.status %></p><small>Scopes: <%= (link.scopes||[]).join(', ') %></small></div><% if(link.status==='active'){ %><form method="post" action="/app/companion/<%= link.id %>/revoke"><button class="button button-danger button-sm">Revoke</button></form><% } %></article><% }) %></div>
</section>
