<section class="page-shell">
  <div class="page-header split-header"><div><span class="eyebrow">Return to Self</span><h1>Your recovery is not a straight line.</h1><p>This is a non-clinical view of what you have noticed, carried, rested through and chosen to remember.</p></div><div class="weather-card"><small>Emotional weather</small><strong><%= forecast.headline %></strong><span>Confidence: <%= forecast.confidence %></span></div></div>
  <div class="dashboard-grid">
    <section class="card span-2 hearth-card"><div class="section-heading"><div><span class="eyebrow">The Hearthstone™</span><h2>Your living hearth</h2></div></div><div class="hearth" aria-label="Hearthstone milestones"><div class="hearth-fire">✦</div><% milestones.slice(0,12).forEach((m,i)=>{ %><div class="hearth-stone stone-<%= (i%4)+1 %>" title="<%= m.title %>"><span><%= m.title %></span></div><% }) %></div><p class="muted">Each stone is a milestone you defined. There is no ranking, streak or completion score.</p></section>
    <aside class="card"><span class="eyebrow">Aftercare</span><h2><%= aftercareRate===null?'Beginning':aftercareRate+'%' %></h2><p><%= aftercareRate===null?'Room aftercare appears here once you begin using the Quiet Arcade.':'of recent room exits included their designed landing.' %></p></aside>
    <section class="card span-3"><span class="eyebrow">Place a hearthstone</span><form method="post" action="/app/milestones" class="form-grid milestone-form"><label>What mattered?<input name="title" required maxlength="120" placeholder="I asked for support"></label><label>Kind<select name="stoneType"><option value="healing">Healing</option><option value="rest">Rest</option><option value="return">Return</option><option value="growth">Growth</option></select></label><label class="span-2">A note, if you want<textarea name="note" rows="2"></textarea></label><button class="button" type="submit">Place stone</button></form></section>
    <section class="card span-2"><span class="eyebrow">AI care summaries</span><h2>Structured, not raw chaos</h2><% if(!summaries.length){ %><p class="muted">No care summary has been generated yet.</p><% } %><div class="timeline"><% summaries.forEach(s=>{ %><article><time><%= new Date(s.createdAt).toLocaleDateString() %></time><pre><%= s.summary %></pre><% if(s.reviewedAt){ %><span class="status good">Clinician reviewed</span><% } else { %><span class="status">Awaiting review</span><% } %></article><% }) %></div></section>
    <section class="card"><span class="eyebrow">Recent reflections</span><h2>What you left here</h2><% journals.slice(0,5).forEach(j=>{ %><blockquote><%= j.content.slice(0,180) %><%= j.content.length>180?'…':'' %></blockquote><% }) %><a class="text-link" href="/mindfulness">Open journal →</a></section>
  </div>
</section>
