<section class="page-shell">
  <div class="page-header"><span class="eyebrow">Digital Grief & Healing Archive™</span><h1>A place to set down what should not be rushed.</h1><p>Stories, letters and memories can stay private, or be shared with your assigned therapist only when you choose.</p></div>
  <div class="two-column">
    <form method="post" action="/app/grief" class="card form-stack sticky-card"><h2>Add to the archive</h2><label>Title<input name="title" required></label><label>Kind<select name="type"><option value="memory">Memory</option><option value="story">Story</option><option value="letter">Letter never sent</option><option value="audio">Audio note reference</option><option value="photo">Photo memory reference</option></select></label><label>What do you want to remember or release?<textarea name="content" rows="9" required></textarea></label><label class="check-line"><input type="checkbox" name="sharedWithTherapist"><span>Share this item with my therapist</span></label><button class="button" type="submit">Save privately</button></form>
    <section class="archive-grid"><% if(!items.length){ %><div class="empty-state"><span>○</span><h2>Your archive is quiet.</h2><p>It can stay that way until you want it.</p></div><% } %><% items.forEach(item=>{ %><article class="card archive-item"><div class="section-heading"><span class="tag"><%= item.type %></span><small><%= new Date(item.createdAt).toLocaleDateString() %></small></div><h2><%= item.title %></h2><p class="preserve-lines"><%= item.content %></p><small><%= item.sharedWithTherapist?'Shared with therapist':'Private to you' %></small></article><% }) %></section>
  </div>
</section>
